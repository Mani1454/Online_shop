{
  "expo": {
    "name": "Apna Kirana",
    "slug": "apna-kirana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#15803D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.store.apnakirana",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Apna Kirana uses your location to deliver groceries and fresh essentials directly to your doorstep.",
        "NSCameraUsageDescription": "Used to scan UPI payment QR codes at checkout.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.store.apnakirana",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15803D"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "15de8dbb-d047-4f7b-a3df-b5c1d653783f"
      }
    },
    "owner": "manis8873"
  }
}
